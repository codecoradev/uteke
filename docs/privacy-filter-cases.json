{
  "format": "Shared test vectors of the OSS privacy filter (uteke_core::privacy::redact, #1464) so uteke-cloud can pin parity in CI. For each case: join the strings of `input` (no separator) to get the text, run the filter with an empty allowlist, and expect exactly `expected` and the list `kinds` of [kind, count] pairs ordered by kind (empty when nothing is masked). A case without `expected` must come back unchanged (its `kinds` is empty). Version 3 (precision and recall fixes found by two adversarial reviews of the first versions: generic words such as key, pass and token are not names unless compound; quoted values, URL query strings and glued pairs are read whole). Inputs are split into fragments and unchanged texts are not repeated, so no complete token or key header appears in this file; none of the values is a real credential, and secret scanners may still flag the assignment-shaped lines.",
  "version": 3,
  "cases": [
    {
      "name": "github token keeps its prefix",
      "input": [
        "use ",
        "ghp_",
        "aB3dE5gH7jK9mN1pQ3rS5tU7vW9xY1zA3bC5",
        " for the repo"
      ],
      "expected": "use ghp_[REDACTED:github-token] for the repo",
      "kinds": [
        [
          "github-token",
          1
        ]
      ]
    },
    {
      "name": "fine-grained github token",
      "input": [
        "github_pat_",
        "11ABCDEFG0abcdefghij_klmnopqrstuvwxyz0123456789"
      ],
      "expected": "github_pat_[REDACTED:github-token]",
      "kinds": [
        [
          "github-token",
          1
        ]
      ]
    },
    {
      "name": "aws access key keeps its prefix",
      "input": [
        "key id ",
        "AKIA",
        "IOSFODNN7EXAMPLQ"
      ],
      "expected": "key id AKIA[REDACTED:aws-access-key]",
      "kinds": [
        [
          "aws-access-key",
          1
        ]
      ]
    },
    {
      "name": "bearer header with a jwt is a bearer token",
      "input": [
        "Authorization: Bearer ",
        "eyJhbGciOiJIUzI1NiJ9",
        ".",
        "eyJzdWIiOiIxMjM0NTY3ODkwIn0",
        ".",
        "dBjftJeZ4CVPmB92K27uhbUJU1p1r"
      ],
      "expected": "Authorization: Bearer [REDACTED:bearer-token]",
      "kinds": [
        [
          "bearer-token",
          1
        ]
      ]
    },
    {
      "name": "bare jwt",
      "input": [
        "cookie ",
        "eyJhbGciOiJIUzI1NiJ9",
        ".",
        "eyJzdWIiOiIxMjM0NTY3ODkwIn0",
        ".",
        "dBjftJeZ4CVPmB92K27uhbUJU1p1r"
      ],
      "expected": "cookie [REDACTED:jwt]",
      "kinds": [
        [
          "jwt",
          1
        ]
      ]
    },
    {
      "name": "private key block is removed whole",
      "input": [
        "before\n",
        "-----BEGIN ",
        "RSA PRIVATE",
        " KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASC\nabcdefgh\n-----END ",
        "RSA PRIVATE",
        " KEY-----",
        "\nafter"
      ],
      "expected": "before\n[REDACTED:private-key]\nafter",
      "kinds": [
        [
          "private-key",
          1
        ]
      ]
    },
    {
      "name": "sk- api key",
      "input": [
        "sk-",
        "proj-Ab3dE5gH7jK9mN1pQ3rS5tU7"
